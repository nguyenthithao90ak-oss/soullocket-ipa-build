# Copy this file to functions/.env locally or inject these values via your deployment secret store.
# Never commit real mailbox credentials or OTP secrets to git.

OTP_SECRET=replace-with-random-server-side-secret
GMAIL_EMAIL=replace-with-primary-sender@example.com
GMAIL_APP_PASSWORD=replace-with-app-password
GMAIL_ACCOUNTS=replace-with-sender1@example.com:app-password-1,replace-with-sender2@example.com:app-password-2
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=ccombooppen
OPENAI_BASE_URL=https://your-9router-tunnel.example/v1
OPENAI_FALLBACK_BASE_URL=
OPENAI_WIRE_API=responses
