	<key>NSCameraUsageDescription</key>
	<string>Ứng dụng cần quyền camera để chụp ảnh kỷ niệm, quét mã QR kết nối hoặc đăng nhập và dùng cuộc gọi video khi bạn chủ động bật tính năng đó.</string>
	<key>NSFaceIDUsageDescription</key>
